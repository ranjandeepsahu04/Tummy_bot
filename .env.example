# Server Config
PORT=5000
NODE_ENV=development
CORS_ORIGIN=*

# PostgreSQL Database URL
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/tummy_bot?schema=public"

# Authentication Security Secrets
JWT_SECRET=super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=super-secret-refresh-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# WhatsApp Provider Configuration ("meta" or "twilio")
WHATSAPP_PROVIDER=meta

# Meta Official WhatsApp Cloud API Credentials
META_PHONE_NUMBER_ID=1234567890
META_WHATSAPP_TOKEN=EAAG...YOUR_META_PERMANENT_TOKEN
META_WEBHOOK_VERIFY_TOKEN=tummy_bot_verify_token_12345

# Optional Twilio Provider Setup
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Default Payment UPI Settings
DEFAULT_UPI_ID=merchant@upi
DEFAULT_UPI_NAME=WhatsApp Food Station
