PORT=5000
NODE_ENV=development
CORS_ORIGIN=*

DATABASE_URL="file:./dev.db"

JWT_SECRET=super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=super-secret-refresh-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# WhatsApp Provider Selection ("baileys", "twilio", or "meta")
WHATSAPP_PROVIDER=baileys

# Twilio Credentials (Optional)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Meta Config (Optional)
META_PHONE_NUMBER_ID=your_meta_phone_id
META_WHATSAPP_TOKEN=your_meta_token
META_WEBHOOK_VERIFY_TOKEN=tummy_bot_verify_token_12345

DEFAULT_UPI_ID=tummystation@upi
DEFAULT_UPI_NAME=WhatsApp Food Station
